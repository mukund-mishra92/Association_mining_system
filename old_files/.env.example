# ========================================
# 🤖 GROK AI CONFIGURATION (PRIMARY)
# ========================================
# Get your Grok API key from: https://console.x.ai/
# This is used for NEO Chatbot (Knowledge Base, SQL Assistant, Diagnostics)
GROK_API_KEY=your_grok_api_key_here

# Alternative AI Providers (Fallback - Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================================
# 💾 DATABASE CONFIGURATION
# ========================================
# These credentials are used for:
# - Association Mining
# - SQL Assistant queries  
# - All database operations
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=neo

# Source Tables
ORDER_TABLE=wms_to_wcs_order_line_request_data
SKU_MASTER_TABLE=sku_master

# Output Table
RECOMMENDATIONS_TABLE=sku_recommendations

# Mining Configuration
MIN_SUPPORT=0.45
MIN_CONFIDENCE=0.4
MIN_LIFT=1.0
MAX_RECOMMENDATIONS=3

# Time-based weighting
DECAY_RATE=0.05

# Enhanced mining settings
DEFAULT_TIME_WEIGHTING_METHOD=exponential_decay
DEFAULT_TIME_SEGMENTATION=weekly
USE_ENHANCED_MINING=true

# Temporal scoring weights
TEMPORAL_CONFIDENCE_WEIGHT=0.25
TEMPORAL_LIFT_WEIGHT=0.25
TEMPORAL_SUPPORT_WEIGHT=0.15
TEMPORAL_STABILITY_WEIGHT=0.20
TEMPORAL_TREND_WEIGHT=0.15